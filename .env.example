# Copy to .env and fill in once the Telnyx account + BAA exist.
# Never commit the real .env -- it's already in .gitignore.

TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=
# From the Telnyx portal's Webhooks section -- used to verify inbound
# webhook requests actually came from Telnyx (see webhook_server.py).
TELNYX_PUBLIC_KEY=
# Your own random secret, shared between this server and whatever calls
# /tools/* (the Telnyx AI Assistant config). Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
TOOLS_SHARED_SECRET=
ANTHROPIC_API_KEY=
