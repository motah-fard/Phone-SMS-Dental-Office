# Copy to .env and fill in once the Telnyx account + BAA exist.
# Never commit the real .env -- it's already in .gitignore.

TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=
# From the Telnyx portal's Webhooks section -- used to verify inbound
# webhook requests actually came from Telnyx (see webhook_server.py).
TELNYX_PUBLIC_KEY=
# Your own random secret, shared between this server and whatever calls
# /tools/* (the Telnyx AI Assistant config). Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
TOOLS_SHARED_SECRET=

# Which LLM handles open-ended SMS replies: "anthropic" (default) or
# "openai". Only the key for whichever one you pick needs to be real.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Where reschedule_appointment() writes the change back to: "sqlite"
# (default, the fake simulated source) or "pervasive" (the real
# PracticeWorks database via source_system/pervasive_odbc_source.py --
# requires pyodbc + a working Tutor_DSN/production DSN on this machine).
SOURCE_BACKEND=sqlite
